# CricInsight Environment Configuration

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_USER=cricinsight
POSTGRES_PASSWORD=cricinsight_secure_pass
POSTGRES_DB=cricinsight
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Primary NLP Provider (Google Gemini)
LLM_PRIMARY_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CONNECT_TIMEOUT=3
GEMINI_TOTAL_TIMEOUT=10

# Local Fallback Provider (Qwen via Ollama)
LLM_FALLBACK_PROVIDER=qwen
LLM_FALLBACK_ENABLED=true
QWEN_BASE_URL=http://localhost:11434
QWEN_MODEL=qwen2.5:3b-instruct
QWEN_CONTEXT_LENGTH=4096
QWEN_TOTAL_TIMEOUT=20

# Orchestrator Request Boundaries
LLM_MAX_TOTAL_DEADLINE=32

# Storage & Ingestion Paths
RAW_DATA_DIR=data/cricsheet
DUCKDB_PATH=data/cricinsight.duckdb
API_HOST=0.0.0.0
API_PORT=8000
